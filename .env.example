# Copy this file to `.env` and tweak to taste.  All values are optional.

# ---- Brain (the local LLM served by Ollama) ----
BEASTT_MODEL=llama3.2                 # try: qwen3, llama3.1:8b, phi4, mistral
BEASTT_OLLAMA_URL=http://localhost:11434
BEASTT_TIMEOUT=300                    # seconds; raise if document generation times out

# ---- Hosted models (all optional) ----
# Add a key and that provider's models appear in the picker in the chat UI.
# Nothing here is required: with no keys set, JARVIS uses the local model above
# and no conversation ever leaves your machine.
#
# GitHub Models needs no new signup -- it reuses BEASTT_GITHUB_TOKEN below.
# Add the 'models:read' scope to that token to switch it on.
BEASTT_GROQ_KEY=                      # free tier, no card: https://console.groq.com/keys
BEASTT_CEREBRAS_KEY=                  # free tier, big daily budget: https://cloud.cerebras.ai
BEASTT_OPENROUTER_KEY=                # many models, ':free' ones cost nothing: https://openrouter.ai/keys
BEASTT_MISTRAL_KEY=                   # https://console.mistral.ai/api-keys
BEASTT_OPENAI_KEY=                    # paid: https://platform.openai.com/api-keys

# Which model to start with, as provider:model. Empty = the local BEASTT_MODEL.
# Examples: groq:llama-3.3-70b-versatile | github:openai/gpt-4.1-mini | ollama:qwen3
BEASTT_DEFAULT_MODEL=

# ---- Personality ----
BEASTT_NAME=JARVIS                    # what to call your assistant (also the wake word)
BEASTT_USER_NAME=friend               # what BEASTT calls you

# ---- Voice ----
BEASTT_VOICE=off                      # off | on   (can also use the --voice flag)
BEASTT_TTS_RATE=175                   # speaking speed (words per minute)
BEASTT_STT_MODEL=base                 # whisper model: tiny | base | small | medium

# ---- Wake word / standby mode (python main.py --wake) ----
BEASTT_WAKE_MODEL=tiny                # small+fast model used while idling
BEASTT_ON_WAKE=ask                    # ask | voice | text
BEASTT_WAKE_WORDS=                    # extra spellings, comma separated

# ---- Long-term memory (remembers you across sessions) ----
BEASTT_MEMORY=on                      # on | off
BEASTT_MEMORY_PATH=beastt_memory/memory.json
BEASTT_MEMORY_RECALL=8                # max remembered facts fed per reply

# ---- Web search (live info: news, weather, facts) ----
BEASTT_SEARCH=on                      # on | off
BEASTT_SEARCH_RESULTS=5               # how many results to feed the brain

# ---- Speaker recognition (respond to only YOUR voice) ----
# Advanced/optional. Leave off: when it misjudges, the assistant stops
# responding to you. Requires --enroll AND --enroll-other to work well.
BEASTT_MY_VOICE_ONLY=off              # off | on
BEASTT_SPEAKER_THRESHOLD=0.80         # used only if no other voices enrolled
BEASTT_SPEAKER_MARGIN=0.04            # how far your match must lead others by
BEASTT_VOICEPRINT=beastt_memory/voiceprint.npz

# ---- Documents (PowerPoint / Word / Excel generation) ----
BEASTT_DOCUMENTS=on                   # on | off
BEASTT_DOC_THEME=navy                 # navy | slate | plum | ember
BEASTT_IMAGES=on                      # on | off -- openly-licensed photos in slides
# Needs: pip install -r requirements-docs.txt

# ---- GitHub access (push generated files, browse repos) ----
# Create a token at https://github.com/settings/tokens with the 'repo' scope.
# Add the 'models:read' scope too and this same token unlocks GitHub Models
# (free hosted models) in the model picker -- no separate signup needed.
# Keep this secret; never commit your .env file.
BEASTT_GITHUB_TOKEN=
BEASTT_GITHUB_REPO=                   # default repo to push to, e.g. my-notes
BEASTT_GITHUB_FOLDER=jarvis           # folder inside the repo for uploads
BEASTT_GITHUB_ASK=on                  # on = ask which repo each time; off = use the default

# ---- Coding help ----
BEASTT_CODE=on                        # write code, scaffold projects, clone repos
# Running shell commands. Off by default -- this is the riskiest capability.
# Destructive commands are always refused; others need your confirmation.
BEASTT_SHELL=off                      # off | on
