# Copy this file to `.env` and tweak to taste.  All values are optional.

# ---- Brain (the local LLM served by Ollama) ----
BEASTT_MODEL=llama3.2                 # try: qwen3, llama3.1:8b, phi4, mistral
BEASTT_OLLAMA_URL=http://localhost:11434

# ---- Personality ----
BEASTT_NAME=BEASTT
BEASTT_USER_NAME=friend               # what BEASTT calls you

# ---- Voice ----
BEASTT_VOICE=off                      # off | on   (can also use the --voice flag)
BEASTT_TTS_RATE=175                   # speaking speed (words per minute)
BEASTT_STT_MODEL=base                 # whisper model: tiny | base | small | medium

# ---- Long-term memory (remembers you across sessions) ----
BEASTT_MEMORY=on                      # on | off
BEASTT_MEMORY_PATH=beastt_memory/memory.json
BEASTT_MEMORY_RECALL=8                # max remembered facts fed per reply

# ---- Web search (live info: news, weather, facts) ----
BEASTT_SEARCH=on                      # on | off
BEASTT_SEARCH_RESULTS=5               # how many results to feed the brain

# ---- Speaker recognition (respond to only YOUR voice) ----
BEASTT_MY_VOICE_ONLY=off              # off | on  (or use the --my-voice flag)
BEASTT_SPEAKER_THRESHOLD=0.80         # used only if no other voices enrolled
BEASTT_SPEAKER_MARGIN=0.04            # how far your match must lead others by
BEASTT_VOICEPRINT=beastt_memory/voiceprint.npz
