# Copy this file to `.env` and tweak to taste.  All values are optional.

# ---- Brain (the local LLM served by Ollama) ----
BEASTT_MODEL=llama3.2                 # try: qwen3, llama3.1:8b, phi4, mistral
BEASTT_OLLAMA_URL=http://localhost:11434
BEASTT_TIMEOUT=300                    # seconds; raise if document generation times out

# ---- Hosted models (all optional) ----
# Add a key and that provider's models appear in the picker in the chat UI.
# Nothing here is required: with no keys set, JARVIS uses the local model above
# and no conversation ever leaves your machine.
BEASTT_GROQ_KEY=                      # free tier, no card: https://console.groq.com/keys
BEASTT_CEREBRAS_KEY=                  # free tier, big daily budget: https://cloud.cerebras.ai
BEASTT_OPENROUTER_KEY=                # many models, ':free' ones cost nothing: https://openrouter.ai/keys
BEASTT_MISTRAL_KEY=                   # https://console.mistral.ai/api-keys
BEASTT_OPENAI_KEY=                    # paid: https://platform.openai.com/api-keys

# Which model to start with, as provider:model. Empty = the local BEASTT_MODEL.
# Examples: groq:llama-3.3-70b-versatile | github:openai/gpt-4.1-mini | ollama:qwen3
BEASTT_DEFAULT_MODEL=

# ---- Personality ----
BEASTT_NAME=JARVIS                    # what to call your assistant (also the wake word)
BEASTT_USER_NAME=friend               # what BEASTT calls you

# ---- Voice ----
BEASTT_VOICE=off                      # off | on   (can also use the --voice flag)
BEASTT_TTS_RATE=175                   # speaking speed (words per minute)
BEASTT_STT_MODEL=base                 # whisper model: tiny | base | small | medium

# ---- Wake word / standby mode (python main.py --wake) ----
BEASTT_WAKE_MODEL=tiny                # small+fast model used while idling
# What happens once it hears its name.
#   ask    -- asks whether you want voice or text
#   voice  -- starts talking straight away
#   text   -- opens a console to type in
#   ui     -- greets you out loud and opens the chat interface in your browser
# Whichever you pick, it now greets you BY NAME the moment it hears you, so you
# can tell "it heard me" from "it didn't" without watching a log file.
BEASTT_ON_WAKE=ask                    # ask | voice | text | ui
BEASTT_UI_PORT=8765                   # port the chat interface uses
# "ask" asks each time. Set "voice" if you run the background service and never
# want the question -- there is no console to type at there anyway.
BEASTT_WAKE_WORDS=                    # extra spellings, comma separated

# ---- Long-term memory (remembers you across sessions) ----
BEASTT_MEMORY=on                      # on | off
BEASTT_MEMORY_PATH=beastt_memory/memory.json
BEASTT_MEMORY_RECALL=8                # max remembered facts fed per reply

# ---- Web search (live info: news, weather, facts) ----
BEASTT_SEARCH=on                      # on | off
BEASTT_SEARCH_RESULTS=5               # how many results per query
# How many of the top results to open and READ, rather than trusting the search
# engine's twenty-word snippet. Snippets are why answers used to read like
# confident summaries of pages nobody had opened. Costs about a second each.
# 0 restores snippet-only behaviour.
BEASTT_SEARCH_READ_PAGES=3            # 0 to 5

# Check that every figure in a reply appears in the material that was actually
# retrieved, and re-ask once if it does not. Deterministic and local -- no extra
# model call unless something is genuinely unsupported.
BEASTT_VERIFY=on                      # on | off

# Live market quotes: Yahoo Finance, with Stooq as a fallback. No key needed.
# Both are undocumented public endpoints, so this is here to be turned off if
# they ever start misbehaving.
BEASTT_QUOTES=on                      # on | off

# ---- Published data (real economic figures, with citations) ----
# Asked about inflation or GDP, a model answers from memory: no source, and
# usually a year or two stale. With this on, the figure is fetched from the
# institution that published it instead.
#   World Bank -- every country, no key at all, works immediately. Annual.
#   FRED       -- US inflation/jobs/rates/yields, monthly to daily. Free key.
BEASTT_DATA=on                        # on | off
BEASTT_FRED_KEY=                      # free, instant: https://fredaccount.stlouisfed.org/apikeys

# ---- Watching a trading bot (read-only) ----
# A bot running elsewhere publishes status.json to a PRIVATE repo; JARVIS reads it
# and answers "how's my bot?". It can never place, close or modify a trade.
BEASTT_BOT_STATUS_REPO=                # e.g. yourname/tradingbot-status
BEASTT_BOT_STATUS_TOKEN=               # read-only token for THAT repo only
BEASTT_BOT_STATUS_FILE=status.json
# Must exceed the publisher's interval, not the bot's poll interval: the heartbeat
# is written every 60s but only published every 300s, so a healthy bot legitimately
# looks a few minutes old from here.
BEASTT_BOT_STALE_MINUTES=15
# Interrupt me when the bot is in trouble, rather than only when I ask. Needs the
# background service running (python main.py --install-startup).
BEASTT_BOT_ALERTS=on                   # on | off
BEASTT_BOT_CHECK_MINUTES=5             # how often to look
BEASTT_BOT_REMIND_MINUTES=60           # how often to repeat an unresolved problem

# ---- Thinking things through ----
# Substantial requests are understood, planned, then worked step by step, with
# each stage shown in the chat. Short or chatty messages always get a straight
# answer. Costs a few model calls per request, so turn it off on a slow machine.
BEASTT_DELIBERATE=on                  # on | off
# The same, for presentations: plan the deck, then write each slide on its own.
BEASTT_DOC_DELIBERATE=on              # on | off

# ---- Speaker recognition (respond to only YOUR voice) ----
# Advanced/optional. Leave off: when it misjudges, the assistant stops
# responding to you. Requires --enroll AND --enroll-other to work well.
BEASTT_MY_VOICE_ONLY=off              # off | on
BEASTT_SPEAKER_THRESHOLD=0.80         # used only if no other voices enrolled
BEASTT_SPEAKER_MARGIN=0.04            # how far your match must lead others by
BEASTT_VOICEPRINT=beastt_memory/voiceprint.npz

# ---- Documents (PowerPoint / Word / Excel generation) ----
BEASTT_DOCUMENTS=on                   # on | off
BEASTT_DOC_THEME=navy                 # navy | slate | plum | ember
BEASTT_IMAGES=on                      # on | off -- openly-licensed photos in slides
# Needs: pip install -r requirements-docs.txt

# ---- Generated artwork for slides ----
# Photos cover real subjects. Nobody has photographed "the three phases of an AI
# rollout", and those slides used to fall back to an abstract shape. With this on
# the picture is generated instead. Always credited as AI-generated.
#   Pollinations -- no key, no signup. Works immediately.
#   Cloudflare   -- FLUX-1-schnell, ~170 images/day free. Steadier once set up.
BEASTT_IMAGE_GEN=on                   # on | off
BEASTT_IMAGE_PREFER=photo             # photo | generated -- which to try first
BEASTT_POLLINATIONS_KEY=              # optional: lifts the anonymous limits
BEASTT_CF_ACCOUNT=                    # Cloudflare account id
BEASTT_CF_TOKEN=                      # token with Workers AI access

# ---- GitHub access (push generated files, browse repos) ----
# Create a token at https://github.com/settings/tokens with the 'repo' scope.
# Keep this secret; never commit your .env file.
BEASTT_GITHUB_TOKEN=
BEASTT_GITHUB_REPO=                   # default repo to push to, e.g. my-notes
BEASTT_GITHUB_FOLDER=jarvis           # folder inside the repo for uploads
BEASTT_GITHUB_ASK=on                  # on = ask which repo each time; off = use the default

# ---- Coding help ----
BEASTT_CODE=on                        # write code, scaffold projects, clone repos
# Running shell commands. Off by default -- this is the riskiest capability.
# Destructive commands are always refused; others need your confirmation.
BEASTT_SHELL=off                      # off | on
